# LINE Messaging API — get these from https://developers.line.biz/console/
# Leave blank to run the prototype in "mock mode" (webhook logs instead of calling LINE).
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=

# Public base URL of the deployed app (used to build LIFF/URI buttons in LINE messages).
# On Vercel this is your production domain, e.g. https://kku-fair-rent.vercel.app
NEXT_PUBLIC_BASE_URL=https://kku-fair-rent.vercel.app
